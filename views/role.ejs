<%- include('partials/head') %>
<%- include('partials/header') %>
<p class="eyebrow"><a href="/domains/<%= domain.id %>"><%= domain.name %></a></p>
<h1><%= role.title %></h1>
<p class="lede"><%= role.summary %></p>
<% if (mine) { %>
  <aside class="mine">
    <p>From your assessment, this role scored <strong><%= mine.score %>/100</strong> · <%= mine.bandLabel %>.</p>
    <p><%= mine.reasons[1] %></p>
    <a href="/results/<%= from %>">Back to that full result</a>
  </aside>
<% } %>
<div class="split">
  <section>
    <h2>A normal week</h2>
    <ol class="week">
      <% role.week.forEach(function (line) { %>
        <li><%= line %></li>
      <% }) %>
    </ol>
  </section>
  <section>
    <h2>Pay, roughly</h2>
    <dl class="pay">
      <div><dt>Early</dt><dd><%= role.salary.early %></dd></div>
      <div><dt>A few years in</dt><dd><%= role.salary.later %></dd></div>
    </dl>
    <p class="fine"><%= role.salary.note %></p>
  </section>
</div>
<h2>Skills this role leans on</h2>
<ul class="skill-weights">
  <% skills.forEach(function (skill) { %>
    <li>
      <span class="tag"><%= skill.weightWord %></span>
      <div>
        <strong><%= skill.label %></strong>
        <p><%= skill.detail %></p>
      </div>
    </li>
  <% }) %>
</ul>
<h2>How people usually get in</h2>
<ul class="plain">
  <% role.entry.forEach(function (line) { %>
    <li><%= line %></li>
  <% }) %>
</ul>
<h2>Where to learn it</h2>
<ul class="resources">
  <% role.resources.forEach(function (item) { %>
    <li>
      <a href="<%= item.url %>" rel="noopener noreferrer"><%= item.title %></a>
      <span class="meta"><%= item.kind %> · <%= item.cost %></span>
      <p><%= item.note %></p>
    </li>
  <% }) %>
</ul>
<% if (others.length) { %>
  <h2>Other roles in <%= domain.name %></h2>
  <ul class="inline-links">
    <% others.forEach(function (item) { %>
      <li><a href="/roles/<%= item.id %><%= from ? '?from=' + from : '' %>"><%= item.title %></a></li>
    <% }) %>
  </ul>
<% } %>
<h2>Nearby fields</h2>
<ul class="inline-links">
  <% neighbours.forEach(function (item) { %>
    <li><a href="/domains/<%= item.id %>"><%= item.name %></a></li>
  <% }) %>
</ul>
<p class="actions"><a class="button" href="/assess?domain=<%= domain.id %>">Score yourself against this field</a></p>
<%- include('partials/footer') %>