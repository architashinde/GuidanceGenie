<%- include('partials/head') %>
<%- include('partials/header') %>
<p class="eyebrow">Result · <%= assessment.when %></p>
<h1><%= assessment.featured.role.title %>, at <%= assessment.featured.score %>/100.</h1>
<p class="lede"><%= assessment.answers.studyLine %> The lowest piece on the top match is <%= assessment.featured.weak.label %>.</p>
<% if (saved) { %>
  <p class="save-note">Saved on your account. Open it again from <a href="/saved">Saved</a>.</p>
<% } else { %>
  <aside class="save-note">
    <p>This result is tied to this browser session until you keep it. Create an account and it is filed under Saved, with the answers and the scores.</p>
    <p class="actions">
      <a class="button" href="/register">Create an account</a>
      <a class="quiet" href="/login">I already have one</a>
    </p>
  </aside>
<% } %>
<section class="recap">
  <h2>What you told us</h2>
  <dl class="mini">
    <div><dt>Where</dt><dd><%= assessment.answers.stage %></dd></div>
    <div><dt>Study</dt><dd><%= assessment.answers.education %></dd></div>
    <div><dt>Domains</dt><dd><%= assessment.answers.domains.map(d => d.name).join(', ') %></dd></div>
    <div><dt>Workday</dt><dd><%= assessment.answers.focus %></dd></div>
    <div><dt>Setting</dt><dd><%= assessment.answers.setting %></dd></div>
    <div><dt>Pace</dt><dd><%= assessment.answers.pace %></dd></div>
    <div><dt>Skills</dt><dd><%= assessment.answers.skills.map(s => s.label).join(', ') %></dd></div>
    <div><dt>Next two years</dt><dd><%= assessment.answers.priority %></dd></div>
    <div><dt>Learning</dt><dd><%= assessment.answers.study %></dd></div>
    <% if (assessment.answers.note) { %>
      <div><dt>Your note</dt><dd><%= assessment.answers.note %></dd></div>
    <% } %>
  </dl>
</section>
<article class="match featured">
  <header class="match-head">
    <p class="eyebrow"><%= assessment.featured.bandLabel %> · <%= assessment.featured.domain.name %></p>
    <h2><%= assessment.featured.role.title %></h2>
    <p class="score"><span><%= assessment.featured.score %></span>/100</p>
    <div class="meter" aria-hidden="true"><span style="width: <%= assessment.featured.score %>%"></span></div>
  </header>
  <p><%= assessment.featured.role.summary %></p>
  <ol class="reasons">
    <% assessment.featured.reasons.forEach(function (line) { %>
      <li><%= line %></li>
    <% }) %>
  </ol>
  <p class="fine"><%= assessment.featured.rawLabel %> of <%= assessment.featured.maxRaw %> raw points, scaled to 100. <a href="/how">The sheet</a>.</p>
  <div class="split">
    <section>
      <h3>Points</h3>
      <table class="sheet">
        <thead>
          <tr><th>Piece</th><th>Points</th></tr>
        </thead>
        <tbody>
          <% assessment.featured.sheet.forEach(function (row) { %>
            <tr>
              <td><%= row.label %><% if (row.note) { %><small><%= row.note %></small><% } %></td>
              <td><%= row.got %> / <%= row.max %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
    <section>
      <h3>Skills</h3>
      <% if (assessment.featured.matched.length) { %>
        <p class="fine">You marked</p>
        <ul class="pills">
          <% assessment.featured.matched.forEach(function (skill) { %>
            <li><%= skill.label %></li>
          <% }) %>
        </ul>
      <% } else { %>
        <p>Nothing you marked is on this role’s list.</p>
      <% } %>
      <% if (assessment.featured.gaps.length) { %>
        <p class="fine">Learn next, heavier first</p>
        <ol class="plain">
          <% assessment.featured.gaps.forEach(function (skill) { %>
            <li><strong><%= skill.label %></strong> · <%= skill.weightWord %></li>
          <% }) %>
        </ol>
      <% } %>
    </section>
  </div>
  <h3>Start here</h3>
  <ul class="resources">
    <% assessment.featured.resources.forEach(function (item) { %>
      <li>
        <a href="<%= item.url %>" rel="noopener noreferrer"><%= item.title %></a>
        <span class="meta"><%= item.kind %> · <%= item.cost %></span>
        <p><%= item.note %></p>
      </li>
    <% }) %>
  </ul>
  <p><a href="/roles/<%= assessment.featured.role.id %>?from=<%= assessment.id %>">Open the role brief</a></p>
</article>
<% if (assessment.next.length) { %>
  <h2>The next matches</h2>
  <div class="next-list">
    <% assessment.next.forEach(function (item, index) { %>
      <article class="match compact">
        <p class="eyebrow"><%= index + 2 %> · <%= item.bandLabel %> · <%= item.score %>/100</p>
        <h3><a href="/roles/<%= item.role.id %>?from=<%= assessment.id %>"><%= item.role.title %></a></h3>
        <p class="fine"><%= item.domain.name %></p>
        <p><%= item.reasons[0] %></p>
        <p><%= item.reasons[1] %></p>
        <% if (item.gaps.length) { %>
          <p class="fine">First gap: <%= item.gaps[0].label %></p>
        <% } %>
      </article>
    <% }) %>
  </div>
<% } %>
<h2>Every role, same sheet</h2>
<p class="fine">The four above are the ones worth reading first. The rest stayed in the ranking so you can see what the sheet did not prefer.</p>
<div class="table-wrap">
  <table class="rank">
    <thead>
      <tr>
        <th>Rank</th>
        <th>Role</th>
        <th>Field</th>
        <th>Score</th>
        <th>Read</th>
      </tr>
    </thead>
    <tbody>
      <% assessment.all.forEach(function (item, index) { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= item.role.title %></td>
          <td><%= item.domain.name %></td>
          <td><%= item.score %> · <%= item.bandLabel %></td>
          <td><a href="/roles/<%= item.role.id %>?from=<%= assessment.id %>">Brief</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<p class="actions"><a class="button secondary" href="/assess">Take it again</a></p>
<%- include('partials/footer') %>