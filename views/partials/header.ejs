<body>
  <a class="skip" href="#content">Skip to content</a>
  <header class="top">
    <div class="top-inner">
      <a class="mark" href="/">GuidanceGenie</a>
      <nav aria-label="Primary">
        <a class="<%= page === 'domains' ? 'is-on' : '' %>" href="/domains">Catalogue</a>
        <a class="<%= page === 'assess' ? 'is-on' : '' %>" href="/assess">Questionnaire</a>
        <a class="<%= page === 'how' ? 'is-on' : '' %>" href="/how">Scoring</a>
        <% if (user) { %>
          <a class="<%= page === 'saved' ? 'is-on' : '' %>" href="/saved">Saved</a>
          <form action="/logout" method="post">
            <button type="submit">Sign out</button>
          </form>
        <% } else { %>
          <a class="<%= page === 'account' ? 'is-on' : '' %>" href="/login">Sign in</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main id="content" class="layout">
    <% if (flash) { %>
      <p class="flash" role="status"><%= flash %></p>
    <% } %>